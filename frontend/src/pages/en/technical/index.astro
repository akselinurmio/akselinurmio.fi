---
import BaseLayout from '../../../components/BaseLayout.astro';
import '../../../styles/technical.css';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://akselinurmio.fi/en/technical/",
  "url": "https://akselinurmio.fi/en/technical/",
  "name": "Technical details",
  "description": "Technical details about this website",
  "inLanguage": "en",
  "isPartOf": { "@id": "https://akselinurmio.fi/#website" }
};

const speculationRules = {
  "prerender": [
    {
      "source": "list",
      "urls": ["/en/"]
    }
  ],
  "prefetch": [
    {
      "source": "list",
      "urls": ["/en/"]
    }
  ]
};
---

<BaseLayout
  title="Technical details - Akseli Nurmio"
  description="Technical details about this website - built with modern web technologies, accessibility standards, and performance optimization."
  lang="en"
  canonical="https://akselinurmio.fi/en/technical/"
  alternateHrefLang={{
    "en": "https://akselinurmio.fi/en/technical/"
  }}
  structuredData={structuredData}
  speculationRules={speculationRules}
>

  <div class="top-container">
    <main class="main">
      <div class="left-side-content">
        <h1>Technical details</h1>
        <p>
          This website is built with modern web technologies, focusing on
          <b>accessibility</b>, <b>performance</b>, and maintainability. It
          uses a <a href="https://parceljs.org/">Parcel-based</a> build system
          that optimizes assets, generates cache headers, and handles
          multilingual content. The site is hosted on
          <a href="https://pages.cloudflare.com/">Cloudflare Pages</a> with an
          edge function for form handling, and includes automated testing with
          <a href="https://playwright.dev/">Playwright</a> for functionality,
          accessibility, and SEO validation.
        </p>

        <section>
          <h2>Source code</h2>
          <p>
            This website is open source and available on GitHub. Feel free to
            explore the code, report issues, or contribute improvements.
          </p>
          <p>
            <a
              href="https://github.com/akselinurmio/akselinurmio.fi"
              class="button"
            >
              <svg class="github-icon" viewBox="0 0 24 24">
                <title>GitHub</title>
                <path
                  fill="currentColor"
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                />
              </svg>
              View on GitHub
            </a>
          </p>
        </section>

        <nav class="back">
          <a href="/en/">← Back to main page</a>
        </nav>
      </div>
    </main>
    <footer class="footer">
      <p>&copy; Akseli Nurmio</p>
    </footer>
  </div>
</BaseLayout>
