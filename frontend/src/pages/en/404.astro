---
import BaseLayout from "../../components/BaseLayout.astro";
---

<BaseLayout title="Page was not found" lang="en" robots="noindex">
  <div class="top-container">
    <main class="main">
      <div class="right-side-content">
        <video
          aria-label="Dog pressing computer keyboard repeatedly"
          autoplay
          loop
          muted
          playsinline
          src="/assets/lazerdog.webm"
          width="400"
          height="300"
          class="animation"></video>
      </div>
      <div class="left-side-content">
        <h1>Page was not found.</h1>
        <p>
          <a href="/en/">Go to front page.</a>
        </p>
      </div>
    </main>
  </div>
</BaseLayout>
