---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Sivua ei löytynyt"
  lang="fi"
  robots="noindex"
>
  <div class="top-container">
    <main class="main">
      <div class="right-side-content">
        <video
          aria-label="Koira tietokoneella"
          autoplay
          loop
          muted
          playsinline
          src="/assets/lazerdog.webm"
          width="400"
          height="300"
          class="animation"
        ></video>
      </div>
      <div class="left-side-content">
        <h1>Sivua ei löytynyt.</h1>
        <p>
          <a href="/">Tästä etusivulle.</a>
        </p>
      </div>
    </main>
  </div>
</BaseLayout>
