---
import AkseliImage from "../components/AkseliImage.astro";
import BaseLayout from "../components/BaseLayout.astro";
import Footer from "../components/Footer.astro";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": new URL(Astro.url.pathname, Astro.site),
  url: new URL(Astro.url.pathname, Astro.site),
  name: "Akseli Nurmio",
  description:
    "Olen Akseli, front end -kehittäjä Ylellä. Teen saavutettavia ja helppokäyttöisiä digipalveluita, koodaan työkseni ja huviksi. Kurkkaa projektit ja laita viestiä!",
  inLanguage: "fi",
  isPartOf: {
    "@type": "WebSite",
    "@id": new URL("/#website", Astro.site),
    url: new URL("/", Astro.site),
    name: "Akseli Nurmio",
    inLanguage: ["en", "fi"],
  },
};

const speculationRulePaths = ["/en/"];
---

<BaseLayout
  title="Akseli Nurmio"
  description="Olen Akseli, front end -kehittäjä Ylellä. Teen saavutettavia ja helppokäyttöisiä digipalveluita, koodaan työkseni ja huviksi. Kurkkaa projektit ja laita viestiä!"
  lang="fi"
  canonical="/"
  alternateHrefLang={{
    en: "/en/",
    fi: "/",
  }}
  structuredData={structuredData}
  speculationRulePaths={speculationRulePaths}
>
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    is:inline
    defer></script>
  <script src="/src/scripts/form.ts"></script>

  <div class="top-container">
    <main class="main">
      <div class="right-side-content">
        <AkseliImage
          alt="Akseli hymyilee, taustalla helsinkiläinen raitiovaunu"
        />
      </div>

      <div class="left-side-content">
        <h1 class="name">Moro, mä oon Akseli.</h1>
        <p>
          Olen monissa liemissä keitetty front end -kehittäjä ja työskentelen
          tällä hetkellä
          <a href="https://areena.yle.fi/tv">Yle Areenan</a>
          sovellus&shy;kehityksen parissa
          <a href="https://yle.dev/" title="yle.dev">Yleisradiolla</a>.
        </p>
        <p lang="en">
          You can also read this page
          <a href="/en/">in English</a>.
        </p>
        <h2>Töi ja röi</h2>
        <ul>
          <li>
            Vastaan tekemästäni työstä <b>ensi&shy;metreistä lähtien</b>, aina
            suunnittelusta tuotteen tai koodin elinkaaren loppuun asti.
          </li>
          <li>
            Pyrin takaamaan tuottamani sisällön tai tuotteen
            <b>saavutettavuuden</b> kaikille ihmisille, kaikissa tilanteissa. Teen
            palveluita, joihin ihmiset voivat luottaa.
          </li>
          <li>
            Teen palveluista <b>helpompia käyttää</b>. Välillä ATK on
            moni&shy;mutkaista, mutta useinkaan sen ei tarvitse olla.
          </li>
        </ul>
        <h2>Harrastuksia</h2>
        <ul>
          <li>
            Vapaa-ajalla tykkään
            <b>pelailla niin video&shy;pelejä kuin pöydän ääressäkin</b>. Tällä
            hetkellä tulee pelailtua mm. <cite>Cyberpunk 2077</cite>:ää ja <cite>Wingspania</cite>.
          </li>
          <li>
            Lämpimän kelin suosikki&shy;harrastukseni on käydä viilettämässä
            <b>polkupyörällä</b> pää&shy;kaupunki&shy;seudun maanteitä ja hiekka&shy;polkuja.
          </li>
          <li>
            Mikään ei voita hyvää <b>seikkailu- tai scifi&shy;leffaa</b>.
            Leffa&shy;festareilla törmää monesti leffoihin, joista ei olisi
            muuten koskaan kuullutkaan.
          </li>
          <li>
            Vaikka töissä saakin koodata mielin määrin, tykkään välillä kokeilla
            uusia juttuja
            <b>omien hassuttelu&shy;projektien</b> merkeissä. Näihin kuuluu mm.
            <a href="https://lemppari.bond/">Kuka on sun lemppari Bond?</a> ja <a href="https://musiclinkconverter.com/">Music Link Converter</a>.
          </li>
        </ul>
        <h2>Muualla verkossa</h2>
        <ul>
          <li>
            <a href="https://www.linkedin.com/in/akselinurmio/">LinkedInistä</a>
            löydät lisää tietoa työhistoriastani
          </li>
          <li>
            <a href="https://untappd.com/user/kaljakseli">Untappdiin</a>
            merkkailen joskus juomiani oluita 🍻
          </li>
        </ul>

        <form
          action="/message"
          method="post"
          aria-labelledby="contact"
          class="form"
          id="contact-form"
        >
          <h2 id="contact">Laita viestiä</h2>
          <div class="form-field">
            <label class="form-label" for="name-input">Nimesi</label>
            <input
              type="text"
              name="name"
              id="name-input"
              autocomplete="name"
              class="form-input"
              maxlength="100"
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="email-input">Meiliosoitteesi</label>
            <input
              type="email"
              name="email"
              id="email-input"
              autocomplete="email"
              class="form-input"
              maxlength="254"
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="message-input">Viestisi</label>
            <textarea
              name="message"
              id="message-input"
              required
              rows="5"
              class="form-input"
              maxlength="2000"></textarea>
          </div>
          <div class="form-field">
            <div class="form-label">Bottitarkistus</div>
            <div class="form-input">
              <div class="cf-turnstile" id="turnstile-widget"></div>
              <noscript>
                <p>Laita JavaScript päälle, jotta bottitarkistus toimii.</p>
              </noscript>
            </div>
          </div>

          <button type="submit" id="submit-button" class="button">
            Lähetä
          </button>

          <output class="output" hidden id="contact-form-output" role="status"
          ></output>
        </form>
      </div>
    </main>
    <Footer locale="fi" />
  </div>
</BaseLayout>
