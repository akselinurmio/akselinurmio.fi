---
import { getAbsoluteLocaleUrl, toCodes } from "astro:i18n";
import { i18n } from "astro:config/client";
import "../styles/style.css";

export interface Props {
  title: string;
  description?: string;
  lang: string;
  robots?: string;
  structuredData?: object;
  speculationRulePaths?: string[];
}

const {
  title,
  description,
  lang = "fi",
  robots,
  structuredData,
  speculationRulePaths,
} = Astro.props;

const indexed = robots !== "noindex";
const currentLocale = Astro.currentLocale ?? i18n!.defaultLocale;
const localePrefix =
  currentLocale === i18n!.defaultLocale ? "" : `/${currentLocale}`;
const localePath = Astro.url.pathname.slice(localePrefix.length) || "/";
const canonical = Astro.url;
const alternates = toCodes(i18n!.locales).map(
  (locale) => [locale, getAbsoluteLocaleUrl(locale, localePath)] as const,
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width" />

    {indexed && <link rel="canonical" href={canonical} />}

    {
      indexed &&
        alternates.map(([lang, href]) => (
          <link rel="alternate" hreflang={lang} href={href} />
        ))
    }

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/assets/favicon.svg"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicon-16x16.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/assets/font/Aeonik-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="author" content="Akseli Nurmio" />
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light" />

    {robots && <meta name="robots" content={robots} />}

    {
      structuredData && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    {
      speculationRulePaths && (
        <script
          is:inline
          type="speculationrules"
          set:html={JSON.stringify({
            prerender: [
              {
                source: "list",
                urls: speculationRulePaths,
              },
            ],
            prefetch: [
              {
                source: "list",
                urls: speculationRulePaths,
              },
            ],
          })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
