---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  lang: "fi" | "en";
}

const { lang } = Astro.props;
const fi = lang === "fi";
---

<BaseLayout
  title={fi ? "Sivua ei löytynyt" : "Page was not found"}
  lang={lang}
  robots="noindex"
>
  <div class="top-container">
    <main class="main">
      <div class="right-side-content">
        <video
          aria-label={fi
            ? "Koira tietokoneella"
            : "Dog pressing computer keyboard repeatedly"}
          autoplay
          loop
          muted
          playsinline
          src="/assets/lazerdog.webm"
          width="400"
          height="300"
          class="animation"></video>
      </div>
      <div class="left-side-content">
        <h1>{fi ? "Sivua ei löytynyt." : "Page was not found."}</h1>
        <p>
          <a href={fi ? "/" : "/en/"}
            >{fi ? "Tästä etusivulle." : "Go to front page."}</a
          >
        </p>
      </div>
    </main>
  </div>
</BaseLayout>
