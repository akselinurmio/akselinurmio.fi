---
import { getImage } from "astro:assets";
import akseliImage from "../assets/akseli.jpg";

interface Props {
  alt: string;
}

const { alt } = Astro.props;

const image200 = await getImage({
  src: akseliImage,
  width: 200,
  format: "webp",
  densities: [1, 2],
});

const image400 = await getImage({
  src: akseliImage,
  width: 400,
  format: "webp",
  densities: [1, 2],
});

const fallbackImage = await getImage({
  src: akseliImage,
  width: 400,
  format: "jpeg",
  priority: true,
});
---

<picture>
  <source
    media="(min-width: 77rem)"
    type="image/webp"
    srcset={image400.srcSet.attribute}
    width={image400.attributes.width}
    height={image400.attributes.height}
  />
  <source
    type="image/webp"
    srcset={image200.srcSet.attribute}
    width={image200.attributes.width}
    height={image200.attributes.height}
  />
  <img
    {alt}
    src={fallbackImage.src}
    width={fallbackImage.attributes.width}
    height={fallbackImage.attributes.height}
    class="portrait"
  />
</picture>
