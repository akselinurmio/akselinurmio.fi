---
interface Props {
  locale: string;
}

const { locale } = Astro.props;
const fi = locale === "fi";
---

<form
  action="/message"
  method="post"
  aria-labelledby="contact"
  class="form"
  id="contact-form"
>
  <h2 id="contact">{fi ? "Laita viestiä" : "Message me"}</h2>
  <div class="form-field">
    <label class="form-label" for="name-input"
      >{fi ? "Nimesi" : "Your name"}</label
    >
    <input
      type="text"
      name="name"
      id="name-input"
      autocomplete="name"
      class="form-input"
      maxlength={100}
    />
  </div>
  <div class="form-field">
    <label class="form-label" for="email-input"
      >{fi ? "Meiliosoitteesi" : "Your email"}</label
    >
    <input
      type="email"
      name="email"
      id="email-input"
      autocomplete="email"
      class="form-input"
      maxlength={254}
    />
  </div>
  <div class="form-field">
    <label class="form-label" for="message-input"
      >{fi ? "Viestisi" : "Your message"}</label
    >
    <textarea
      name="message"
      id="message-input"
      required
      rows="5"
      class="form-input"
      maxlength={2000}></textarea>
  </div>
  <div class="form-field">
    <div class="form-label">{fi ? "Bottitarkistus" : "Bot check"}</div>
    <div class="form-input">
      {
        fi ? (
          <div class="cf-turnstile" id="turnstile-widget" />
        ) : (
          <div id="turnstile-widget" />
        )
      }
      <noscript>
        <p>
          {
            fi
              ? "Laita JavaScript päälle, jotta bottitarkistus toimii."
              : "Turn on JavaScript to see the bot check."
          }
        </p>
      </noscript>
    </div>
  </div>

  <button type="submit" id="submit-button" class="button">
    {fi ? "Lähetä" : "Send"}
  </button>

  <output class="output" hidden id="contact-form-output" role="status"></output>
</form>
