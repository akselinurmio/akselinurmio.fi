---
import { getLastCommitInfo } from "../utils/git";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const commitInfo = await getLastCommitInfo(locale);

const footerText =
  locale === "fi"
    ? `© Akseli Nurmio. Viimeksi päivitetty`
    : `© Akseli Nurmio. Last updated at`;
---

<footer class="footer">
  <p>
    {footerText}
    <a
      href={`https://github.com/akselinurmio/akselinurmio.fi/commit/${commitInfo.longHash}`}
      title={`Commit: ${commitInfo.shortHash}`}
      ><time datetime={commitInfo.dateIso} lang={locale}
        >{commitInfo.dateFormatted}</time
      ></a
    >.
  </p>
</footer>
