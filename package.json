{
  "name": "akselinurmio.fi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "wrangler pages dev --proxy 1234 -- npm run dev:frontend",
    "dev:frontend": "parcel frontend/{,en/}{index,404}.html",
    "prettier:check": "prettier --check --ignore-path .gitignore .",
    "prettier:fix": "prettier --write --ignore-path .gitignore .",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "type-check": "concurrently --group \"npm:type-check:*\"",
    "type-check:frontend": "cd frontend && tsc --noEmit",
    "type-check:functions": "cd functions && tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@cloudflare/workers-types": "^4.20250525.0",
    "@parcel/optimizer-svgo": "^2.15.2",
    "@parcel/packager-raw-url": "^2.15.2",
    "@parcel/transformer-jsonld": "^2.15.2",
    "@parcel/transformer-webmanifest": "^2.15.2",
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.2",
    "parcel": "^2.15.2",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "sharp": "^0.34.2",
    "svgo": "^3.3.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.16.1"
  },
  "browserslist": [
    "defaults and fully supports fetch"
  ]
}
