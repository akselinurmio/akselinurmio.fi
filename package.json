{
  "name": "akselinurmio.fi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd frontend && astro dev",
    "dev:functions": "npm run build:dev && wrangler pages dev frontend/dist",
    "build": "cd frontend && astro build",
    "build:dev": "cd frontend && astro build --devOutput",
    "preview": "cd frontend && astro preview",
    "prettier:check": "prettier --check --ignore-path .gitignore .",
    "prettier:fix": "prettier --write --ignore-path .gitignore .",
    "test": "playwright test",
    "type-check": "concurrently --group \"npm:type-check:*\"",
    "type-check:frontend": "cd frontend && astro check",
    "type-check:functions": "cd functions && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^4.20250831.0",
    "@playwright/test": "^1.55.1",
    "@types/cloudflare-turnstile": "^0.2.2",
    "astro": "^5.13.5",
    "concurrently": "^9.2.1",
    "playwright": "^1.52.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.33.1"
  }
}
