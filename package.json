{
  "name": "akselinurmio.fi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "wrangler pages dev --proxy 1234 -- npm run dev:frontend",
    "dev:frontend": "parcel frontend/{,en/}{index,404}.html",
    "prettier:check": "prettier --check --ignore-path .gitignore .",
    "prettier:fix": "prettier --write --ignore-path .gitignore .",
    "test": "playwright test",
    "type-check": "concurrently --group \"npm:type-check:*\"",
    "type-check:frontend": "cd frontend && tsc --noEmit",
    "type-check:functions": "cd functions && tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^4.20250701.0",
    "@parcel/optimizer-svgo": "^2.15.4",
    "@parcel/packager-raw-url": "^2.15.4",
    "@parcel/transformer-jsonld": "^2.15.4",
    "@parcel/transformer-webmanifest": "^2.15.4",
    "@playwright/test": "^1.53.2",
    "@types/cloudflare-turnstile": "^0.2.2",
    "concurrently": "^9.2.0",
    "parcel": "^2.15.4",
    "playwright": "^1.52.0",
    "prettier": "^3.6.0",
    "sharp": "^0.33.5",
    "svgo": "^4.0.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.22.0"
  },
  "browserslist": [
    "defaults and fully supports fetch"
  ]
}
